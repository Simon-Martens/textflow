{
  "name": "@simon-martens/textflow",
  "version": "0.1.0",
  "description": "Native web components for editable page templates and rich text fields",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -p tsconfig.build.json",
    "build:demo": "vite build",
    "check": "tsc --noEmit",
    "test": "playwright test",
    "prepack": "npm run build"
  },
  "dependencies": {
    "dompurify": "^3.2.0",
    "marked": "^17.0.0",
    "postcss": "^8.5.30"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "monaco-editor": "^0.55.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
